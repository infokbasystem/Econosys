@baseUrl = https://localhost:5001
@token = replace-with-access-token
@supplierOrderId = 1

### Search all supplier orders: omit person properties when all people are selected
POST {{baseUrl}}/api/supplierorders/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pagination": { "pageNumber": 1, "pageSize": 25 }
}

### Filter by the customer's responsible salesperson AND the order's creator
# Multiple IDs within each list are alternatives. An empty list matches no orders.
POST {{baseUrl}}/api/supplierorders/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerResponsibleUserIds": [1, 2],
  "createdByIds": [3],
  "pagination": { "pageNumber": 1, "pageSize": 25 }
}

### Branded purchase order PDF in the supplier's language
GET {{baseUrl}}/api/pdf/supplierorder/{{supplierOrderId}}
Authorization: Bearer {{token}}

### Unknown supplier order PDF returns 404
GET {{baseUrl}}/api/pdf/supplierorder/2147483647
Authorization: Bearer {{token}}